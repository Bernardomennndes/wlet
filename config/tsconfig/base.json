{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /**
     * Proíbe sintaxe que só existe em TypeScript e precisa de transformação para sumir —
     * parameter property, enum, namespace. É por isso que o projeto não tem uma única classe
     * fora dos erros, e a camada de serviços usa factory com closure em vez de classe.
     */
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
