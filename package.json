{
  "name": "wlet",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "oxlint",
    "type:check": "turbo type:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ingest": "pnpm --filter @wlet/web ingest",
    "cdi": "pnpm --filter @wlet/web cdi",
    "package": "pnpm --filter @wlet/web package",
    "setup": "pnpm --filter @wlet/web setup",
    "preview": "pnpm --filter @wlet/web preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "oxlint": "^1.79.0",
    "turbo": "^2.5.6"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "better-auth": "^1.7.4"
  }
}
