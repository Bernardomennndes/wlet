{
  "name": "@wlet/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup": "tsx scripts/setup.ts",
    "cdi": "tsx scripts/fetch-cdi.ts",
    "build": "tsc -b && vite build",
    "check": "tsx --test scripts/checks/*.test.ts",
    "preview": "vite preview",
    "ingest": "tsx scripts/ingest.ts && biome format --write src/generated",
    "package": "tsx scripts/package.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type:check": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@wlet/domain": "workspace:*",
    "@wlet/ingest": "workspace:*",
    "@wlet/lib": "workspace:*",
    "@wlet/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "@wlet/tsconfig": "workspace:*"
  }
}
